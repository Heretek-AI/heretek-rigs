{
  "promptTimeoutMs": 60000,
  "permission": {
    "*": "deny",
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "allow",
    "edit": "allow",
    "ast_grep": "allow",
    "ast_search": "allow",
    "code_overview": "allow",
    "lsp_diagnostics": "allow",
    "lsp_hover": "allow",
    "lsp_definition": "allow",
    "lsp_references": "allow",
    "lsp_symbols": "allow",
    "lsp_completions": "allow",
    "code_rewrite": "deny",
    "lsp_rename": "deny",
    "lsp_code_actions": "deny",
    "tool_search": "allow",
    "bash": {
      "*": "deny",
      "cargo bench*": "allow",
      "cargo test engine*": "allow",
      "cmake --build*": "allow",
      "ctest*": "allow",
      "cmake --version*": "allow",
      "cmake -S *": "allow",
      "clang --version*": "allow",
      "date +%s": "allow",
      "rig whoami*": "allow",
      "rig ps*": "allow",
      "rig queue *": "allow",
      "rig send *": "allow",
      "rig capture *": "allow",
      "rig transcript *": "allow",
      "git status*": "allow",
      "git diff --stat*": "allow",
      "git diff --name-only*": "allow",
      "git log --oneline*": "allow",
      "git show --stat*": "allow",
      "*--output=*": "deny",
      "*--output *": "deny",
      "*--output\t*": "deny",
      "*--output-junit*": "deny",
      "*--output-log*": "deny",
      "*;*": "deny",
      "*|*": "deny",
      "*>*": "deny",
      "*<*": "deny",
      "*&*": "deny",
      "*`*": "deny",
      "*$*": "deny",
      "*(*": "deny",
      "*)*": "deny",
      "* -p*": "deny",
      "*\t-p*": "deny",
      "*--patch*": "deny",
      "*--full-diff*": "deny",
      "*--textconv*": "deny",
      "* -u*": "deny",
      "*\t-u*": "deny",
      "* -U*": "deny",
      "*\t-U*": "deny",
      "*--unified*": "deny",
      "*--cc*": "deny",
      "* -c *": "deny",
      "*\t-c *": "deny",
      "* -c\t*": "deny",
      "*\t-c\t*": "deny",
      "* -m *": "deny",
      "*\t-m *": "deny",
      "* -m\t*": "deny",
      "*\t-m\t*": "deny",
      "* -W*": "deny",
      "*\t-W*": "deny",
      "*--function-context*": "deny",
      "*--word-diff*": "deny",
      "*--color-words*": "deny",
      "*--binary*": "deny",
      "*--raw*": "deny",
      "*OPENRIG_SESSION_NAME=*": "deny",
      "*OPENRIG_URL=*": "deny",
      "gcc *": "allow",
      "g++ *": "allow"
    },
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*id_rsa*": "deny",
      "*kubeconfig*": "deny",
      "*/secrets/*": "deny",
      ".git/*": "deny",
      "*/.git/*": "deny",
      "AGENTS.md": "deny",
      "*/AGENTS.md": "deny",
      ".pi/*": "deny",
      "*/.pi/*": "deny",
      ".agents/*": "deny",
      "*/.agents/*": "deny",
      "fleet/*": "deny",
      "scripts/*": "deny",
      "*.pat": "deny",
      "*.uri": "deny",
      "*.profile": "deny",
      "*.region": "deny",
      "*.host": "deny",
      "*.password": "deny",
      "*.credentials": "deny",
      "*.config": "deny",
      "*.url": "deny",
      "*.user": "deny",
      "*..*": "deny"
    },
    "path_write": {
      "*": "deny",
      "src/engine/*": "allow",
      "tests/engine/*": "allow",
      "build.sh": "allow",
      "CMakePresets.json": "allow",
      "CMakeLists.txt": "allow",
      "build/*": "allow",
      ".git/*": "deny",
      "*/.git/*": "deny",
      "AGENTS.md": "deny",
      "*/AGENTS.md": "deny",
      ".pi/*": "deny",
      "*/.pi/*": "deny",
      ".agents/*": "deny",
      "*/.agents/*": "deny",
      "fleet/*": "deny",
      "scripts/*": "deny",
      "*..*": "deny"
    },
    "mcp": {
      "*": "deny",
      "codebase-memory": "allow"
    },
    "external_directory": "deny"
  },
  "commandEffects": {
    "cmake": {
      "effects": "read"
    },
    "gcc": {
      "effects": "read",
      "unlessOption": [
        "-o"
      ]
    },
    "g++": {
      "effects": "read",
      "unlessOption": [
        "-o"
      ]
    }
  }
}
