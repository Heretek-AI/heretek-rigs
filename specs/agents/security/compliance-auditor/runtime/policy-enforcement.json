{
  "role": "compliance-auditor",
  "openrig_permission_policy": "builtin:locked",
  "readonly_charter": true,
  "harness": "@gotgenes/pi-permission-system@41.0.0",
  "pi_packages": [
    "@gotgenes/pi-permission-system@41.0.0"
  ],
  "promptTimeoutMs": 60000,
  "permission": {
    "*": "deny",
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "allow",
    "edit": "allow",
    "code_rewrite": "deny",
    "lsp_rename": "deny",
    "lsp_code_actions": "deny",
    "tool_search": "allow",
    "bash": {
      "*": "deny",
      "syft dir*": "allow",
      "npx license-checker*": "allow",
      "cargo license*": "allow",
      "rig whoami*": "allow",
      "rig ps*": "allow",
      "rig queue *": "allow",
      "rig send *": "allow",
      "rig capture *": "allow",
      "rig transcript *": "allow",
      "git status*": "allow",
      "git diff --stat*": "allow",
      "git diff --name-only*": "allow",
      "git log --oneline*": "allow",
      "git show --stat*": "allow",
      "*--output*": "deny",
      "*;*": "deny",
      "*|*": "deny",
      "*>*": "deny",
      "*<*": "deny",
      "*&*": "deny",
      "*`*": "deny",
      "*$*": "deny",
      "*(*": "deny",
      "*)*": "deny",
      "* -p*": "deny",
      "*--patch*": "deny",
      "*--full-diff*": "deny",
      "*--textconv*": "deny"
    },
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*id_rsa*": "deny",
      "*kubeconfig*": "deny",
      "*/secrets/*": "deny",
      ".git/*": "deny",
      "*/.git/*": "deny",
      "AGENTS.md": "deny",
      "*/AGENTS.md": "deny",
      ".pi/*": "deny",
      "*/.pi/*": "deny",
      ".agents/*": "deny",
      "*/.agents/*": "deny",
      "fleet/*": "deny",
      "scripts/*": "deny",
      "*.pat": "deny",
      "*.uri": "deny",
      "*.profile": "deny",
      "*.region": "deny",
      "*.host": "deny",
      "*.password": "deny",
      "*.credentials": "deny",
      "*.config": "deny",
      "*.url": "deny",
      "*.user": "deny",
      "*..*": "deny"
    },
    "path_write": {
      "*": "deny",
      "sbom/*": "allow",
      "docs/compliance/*": "allow",
      ".git/*": "deny",
      "*/.git/*": "deny",
      "AGENTS.md": "deny",
      "*/AGENTS.md": "deny",
      ".pi/*": "deny",
      "*/.pi/*": "deny",
      ".agents/*": "deny",
      "*/.agents/*": "deny",
      "fleet/*": "deny",
      "scripts/*": "deny",
      "*..*": "deny"
    },
    "mcp": {
      "*": "deny",
      "github": "allow"
    },
    "external_directory": "deny"
  }
}
