{
  "promptTimeoutMs": 60000,
  "permission": {
    "*": "deny",
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "allow",
    "edit": "allow",
    "ast_grep": "allow",
    "ast_search": "allow",
    "code_overview": "allow",
    "lsp_diagnostics": "allow",
    "lsp_hover": "allow",
    "lsp_definition": "allow",
    "lsp_references": "allow",
    "lsp_symbols": "allow",
    "lsp_completions": "allow",
    "code_rewrite": "deny",
    "lsp_rename": "deny",
    "lsp_code_actions": "deny",
    "tool_search": "allow",
    "bash": {
      "*": "deny",
      "cargo bench*": "allow",
      "cargo test engine*": "allow",
      "cmake --build*": "allow",
      "ctest*": "allow",
      "cmake --version*": "allow",
      "clang --version*": "allow",
      "rig whoami*": "allow",
      "rig ps*": "allow",
      "rig queue *": "allow",
      "rig send *": "allow",
      "rig capture *": "allow",
      "rig transcript *": "allow",
      "git status*": "allow",
      "git diff --stat*": "allow",
      "git diff --name-only*": "allow",
      "git log --oneline*": "allow",
      "git show --stat*": "allow",
      "*--output*": "deny",
      "*;*": "deny",
      "*|*": "deny",
      "*>*": "deny",
      "*<*": "deny",
      "*&*": "deny",
      "*`*": "deny",
      "*$*": "deny",
      "*(*": "deny",
