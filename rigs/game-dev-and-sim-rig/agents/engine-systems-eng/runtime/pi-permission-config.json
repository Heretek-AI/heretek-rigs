      "*/.agents/*": "deny",
      "fleet/*": "deny",
      "scripts/*": "deny",
      "*.pat": "deny",
      "*.uri": "deny",
      "*.profile": "deny",
      "*.region": "deny",
      "*.host": "deny",
      "*.password": "deny",
      "*.credentials": "deny",
      "*.config": "deny",
      "*.url": "deny",
      "*.user": "deny",
      "*..*": "deny"
