    "path_write": {
      "*": "deny",
      "src/engine/*": "allow",
      "tests/engine/*": "allow",
      ".git/*": "deny",
      "*/.git/*": "deny",
      "AGENTS.md": "deny",
      "*/AGENTS.md": "deny",
      ".pi/*": "deny",
      "*/.pi/*": "deny",
      ".agents/*": "deny",
      "*/.agents/*": "deny",
      "fleet/*": "deny",
      "scripts/*": "deny",
      "*..*": "deny"
    },
    "mcp": {
      "*": "deny",
      "codebase-memory": "allow"
    },
    "external_directory": "deny"
  }
