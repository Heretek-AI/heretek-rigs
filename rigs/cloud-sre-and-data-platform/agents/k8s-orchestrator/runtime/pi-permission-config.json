{
  "promptTimeoutMs": 60000,
  "permission": {
    "*": "deny",
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "allow",
    "edit": "allow",
    "code_rewrite": "deny",
    "lsp_rename": "deny",
    "lsp_code_actions": "deny",
    "tool_search": "allow",
    "bash": {
      "*": "deny",
      "helm lint*": "allow",
      "helm template*": "allow",
      "kubeconform*": "allow",
      "kubectl diff*": "allow",
      "rig whoami*": "allow",
      "rig ps*": "allow",
      "rig queue *": "allow",
      "rig send *": "allow",
      "rig capture *": "allow",
      "rig transcript *": "allow",
      "git status*": "allow",
      "git diff --stat*": "allow",
      "git diff --name-only*": "allow",
      "git log --oneline*": "allow",
      "git show --stat*": "allow"
    },
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*id_rsa*": "deny",
      "*kubeconfig*": "deny",
