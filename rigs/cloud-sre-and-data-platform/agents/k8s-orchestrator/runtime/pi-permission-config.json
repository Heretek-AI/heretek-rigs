      ".pi/*": "deny",
      "*/.pi/*": "deny",
      ".agents/*": "deny",
      "*/.agents/*": "deny",
      "fleet/*": "deny",
      "scripts/*": "deny",
      "*.pat": "deny",
      "*.uri": "deny",
      "*.profile": "deny",
      "*.region": "deny",
      "*.host": "deny",
      "*.password": "deny",
      "*.credentials": "deny",
      "*.config": "deny",
      "*.url": "deny",
      "*.user": "deny",
      "*..*": "deny"
    },
    "path_write": {
      "*": "deny",
      "deploy/*": "allow",
      "k8s/*": "allow",
      ".git/*": "deny",
      "*/.git/*": "deny",
      "AGENTS.md": "deny",
      "*/AGENTS.md": "deny",
      ".pi/*": "deny",
      "*/.pi/*": "deny",
      ".agents/*": "deny",
      "*/.agents/*": "deny",
      "fleet/*": "deny",
      "scripts/*": "deny",
      "*..*": "deny"
    },
    "mcp": {
      "*": "deny",
      "kubernetes": "allow"
    },
    "external_directory": "deny"
  }
}
