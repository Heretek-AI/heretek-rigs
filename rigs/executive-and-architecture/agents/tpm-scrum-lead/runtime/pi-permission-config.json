{
  "promptTimeoutMs": 60000,
  "permission": {
    "*": "deny",
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "allow",
    "edit": "allow",
    "code_rewrite": "deny",
    "lsp_rename": "deny",
    "lsp_code_actions": "deny",
    "tool_search": "allow",
    "bash": {
      "*": "deny",
      "rig whoami*": "allow",
      "rig ps*": "allow",
      "rig queue *": "allow",
      "rig send *": "allow",
      "rig capture *": "allow",
      "rig transcript *": "allow",
      "git status*": "allow",
      "git diff --stat*": "allow",
      "git diff --name-only*": "allow",
      "git log --oneline*": "allow",
      "git show --stat*": "allow",
      "*--output=*": "deny",
      "*--output *": "deny",
      "*--output\t*": "deny",
      "*--output-junit*": "deny",
      "*--output-log*": "deny",
      "*;*": "deny",
      "*|*": "deny",
      "*>*": "deny",
      "*<*": "deny",
      "*&*": "deny",
      "*`*": "deny",
      "*$*": "deny",
      "*(*": "deny",
      "*)*": "deny",
      "* -p*": "deny",
      "*\t-p*": "deny",
      "*--patch*": "deny",
      "*--full-diff*": "deny",
      "*--textconv*": "deny",
      "* -u*": "deny",
      "*\t-u*": "deny",
      "* -U*": "deny",
      "*\t-U*": "deny",
      "*--unified*": "deny",
      "*--cc*": "deny",
      "* -c *": "deny",
      "*\t-c *": "deny",
      "* -c\t*": "deny",
      "*\t-c\t*": "deny",
      "* -m *": "deny",
      "*\t-m *": "deny",
      "* -m\t*": "deny",
      "*\t-m\t*": "deny",
      "* -W*": "deny",
      "*\t-W*": "deny",
      "*--function-context*": "deny",
      "*--word-diff*": "deny",
      "*--color-words*": "deny",
      "*--binary*": "deny",
      "*--raw*": "deny",
      "*OPENRIG_SESSION_NAME=*": "deny",
      "*OPENRIG_URL=*": "deny"
    },
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*id_rsa*": "deny",
      "*kubeconfig*": "deny",
      "*/secrets/*": "deny",
      ".git/*": "deny",
      "*/.git/*": "deny",
      "AGENTS.md": "deny",
      "*/AGENTS.md": "deny",
      ".pi/*": "deny",
      "*/.pi/*": "deny",
      ".agents/*": "deny",
      "*/.agents/*": "deny",
      "fleet/*": "deny",
      "scripts/*": "deny",
      "*.pat": "deny",
      "*.uri": "deny",
      "*.profile": "deny",
      "*.region": "deny",
      "*.host": "deny",
      "*.password": "deny",
      "*.credentials": "deny",
      "*.config": "deny",
      "*.url": "deny",
      "*.user": "deny",
      "*..*": "deny"
    },
    "path_write": {
      "*": "deny",
      "docs/sprints/*": "allow",
      ".git/*": "deny",
      "*/.git/*": "deny",
      "AGENTS.md": "deny",
      "*/AGENTS.md": "deny",
      ".pi/*": "deny",
      "*/.pi/*": "deny",
      ".agents/*": "deny",
      "*/.agents/*": "deny",
      "fleet/*": "deny",
      "scripts/*": "deny",
      "*..*": "deny"
    },
    "mcp": {
      "*": "deny",
      "github": "allow",
      "memory": "allow"
    },
    "external_directory": "deny"
  },
  "commandEffects": [
    {
      "id": "note-effect",
      "argv": [
        "rig",
        "queue",
        "--note"
      ],
      "match": {
        "position": "single-argv-value",
        "pattern": "^[A-Za-z0-9 _\\-/.:|]+$",
        "execModel": "argv-not-shell"
      },
      "covers": [
        "rig queue create --note",
        "rig queue block --note",
        "rig queue update --reopen --note",
        "park-typed-block.py relay",
        "sweep-typed-blocks.py relay"
      ],
      "denyWhen": [
        ";",
        "$",
        "`",
        "$(",
        "OPENRIG_SESSION_NAME=",
        "OPENRIG_URL=",
        "newline",
        "carriage-return"
      ],
      "effect": "allow-effect"
    },
    {
      "id": "body-file-effect",
      "argv": [
        "rig",
        "queue",
        "--body-file"
      ],
      "scope": {
        "cwd": "realpath(CWD)",
        "writeRootsSource": "permissions.path_write",
        "writeRoots": [
          "docs/sprints/*"
        ],
        "scratch": "/var/tmp/seatjail.<pid>.*"
      },
      "constraints": {
        "regularFileOnly": true,
        "maxBytes": 262144,
        "noSymlinkEscape": true,
        "noDotDotEscape": true,
        "noAbsoluteTmp": true
      },
      "covers": [
        "rig queue create --body-file",
        "send-authenticated.sh --source staged relay"
      ],
      "effect": "allow-effect-if-in-scope-else-deny"
    }
  ]
}
