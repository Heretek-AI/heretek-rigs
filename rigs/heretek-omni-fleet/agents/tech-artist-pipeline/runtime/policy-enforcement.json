{
  "role": "tech-artist-pipeline",
  "openrig_permission_policy": "builtin:standard",
  "readonly_charter": false,
  "harness": "@gotgenes/pi-permission-system@41.0.0",
  "pi_packages": [
    "@gotgenes/pi-permission-system@41.0.0",
    "pi-mcp-adapter@5.4.0"
  ],
  "promptTimeoutMs": 60000,
  "permission": {
    "*": "deny",
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "allow",
    "edit": "allow",
    "code_rewrite": "deny",
    "lsp_rename": "deny",
    "lsp_code_actions": "deny",
    "bash": {
      "*": "deny",
      "gltf-transform*": "allow",
      "node tools/asset-pipeline/*": "allow",
      "rig whoami*": "allow",
      "rig ps*": "allow",
      "rig queue *": "allow",
      "rig send *": "allow",
      "rig capture *": "allow",
      "rig transcript *": "allow",
      "git status*": "allow",
      "git diff --stat*": "allow",
      "git diff --name-only*": "allow",
      "git log --oneline*": "allow",
      "git show --stat*": "allow",
      "*--output*": "deny",
      "*;*": "deny",
      "*|*": "deny",
      "*>*": "deny",
      "*<*": "deny",
      "*&*": "deny",
      "*`*": "deny",
      "*$*": "deny",
      "*(*": "deny",
      "*)*": "deny",
      "* -p*": "deny",
      "*\t-p*": "deny",
      "*--patch*": "deny",
      "*--full-diff*": "deny",
      "*--textconv*": "deny",
      "* -u*": "deny",
      "*\t-u*": "deny",
      "* -U*": "deny",
      "*\t-U*": "deny",
      "*--unified*": "deny",
      "*--cc*": "deny",
      "* -c *": "deny",
      "* -m *": "deny",
      "* -W*": "deny",
      "*--function-context*": "deny",
      "*--word-diff*": "deny",
      "*--color-words*": "deny",
      "*--binary*": "deny",
      "*--raw*": "deny",
      "*OPENRIG_SESSION_NAME=*": "deny",
      "*OPENRIG_URL=*": "deny"
    },
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*id_rsa*": "deny",
      "*kubeconfig*": "deny",
      "*/secrets/*": "deny",
      ".git/*": "deny",
      "*/.git/*": "deny",
      "AGENTS.md": "deny",
      "*/AGENTS.md": "deny",
      ".pi/*": "deny",
      "*/.pi/*": "deny",
      ".agents/*": "deny",
      "*/.agents/*": "deny",
      "fleet/*": "deny",
      "scripts/*": "deny",
      "*.pat": "deny",
      "*.uri": "deny",
      "*.profile": "deny",
      "*.region": "deny",
      "*.host": "deny",
      "*.password": "deny",
      "*.credentials": "deny",
      "*.config": "deny",
      "*.url": "deny",
      "*.user": "deny",
      "*..*": "deny"
    },
    "path_write": {
      "*": "deny",
      "assets/*": "allow",
      "tools/asset-pipeline/*": "allow",
      ".git/*": "deny",
      "*/.git/*": "deny",
      "AGENTS.md": "deny",
      "*/AGENTS.md": "deny",
      ".pi/*": "deny",
      "*/.pi/*": "deny",
      ".agents/*": "deny",
      "*/.agents/*": "deny",
      "fleet/*": "deny",
      "scripts/*": "deny",
      "*..*": "deny"
    },
    "mcp": {
      "*": "deny"
    },
    "external_directory": "deny"
  }
}
