{
  "mcpServers": {
    "codebase-memory": {
      "description": "Code knowledge graph of the working repository (symbols, call paths, trace_path).",
      "exposure": "deferred",
      "command": "@TOOLS@/mcp/node_modules/.bin/codebase-memory-mcp",
      "args": []
    },
    "clickhouse": {
      "description": "ClickHouse queries, read-only by default.",
      "exposure": "deferred",
      "command": "uvx",
      "args": [
        "mcp-clickhouse==0.7.0"
      ],
      "env": {
        "CLICKHOUSE_HOST": "!cat @SECRETS@/clickhouse.host",
        "CLICKHOUSE_USER": "!cat @SECRETS@/clickhouse.user",
        "CLICKHOUSE_PASSWORD": "!cat @SECRETS@/clickhouse.password",
        "CLICKHOUSE_ALLOW_WRITE_ACCESS": "false"
      },
      "enabled": false
    },
    "grafana": {
      "description": "Grafana dashboards, datasources, alerting and incident context for SRE seats.",
      "exposure": "deferred",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--network",
        "bridge",
        "-e",
        "GRAFANA_URL",
        "-e",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN",
        "grafana/mcp-grafana:2.0.2"
      ],
      "env": {
        "GRAFANA_URL": "!cat @SECRETS@/grafana.url",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "!cat @SECRETS@/grafana.token"
      },
      "enabled": false
    }
  }
}
