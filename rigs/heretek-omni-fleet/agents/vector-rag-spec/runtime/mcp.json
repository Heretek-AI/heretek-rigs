{
  "mcpServers": {
    "qdrant": {
      "description": "Local Qdrant store for retrieval evaluation.",
      "exposure": "direct",
      "command": "uvx",
      "args": [
        "mcp-server-qdrant==0.8.1"
      ],
      "env": {
        "QDRANT_LOCAL_PATH": "@SEAT@/qdrant",
        "COLLECTION_NAME": "heretek-rag-eval"
      }
    },
    "codebase-memory": {
      "description": "Code knowledge graph of the working repository (symbols, call paths, trace_path).",
      "exposure": "deferred",
      "command": "@TOOLS@/mcp/node_modules/.bin/codebase-memory-mcp",
      "args": []
    }
  }
}
