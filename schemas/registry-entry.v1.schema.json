{
  "$id": "https://openrig.dev/schemas/registry-entry/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "openrig.registry-entry/v1 (heretek-rigs restored baseline)",
  "type": "object",
  "required": ["schema", "slug", "name", "source", "configurations", "status"],
  "properties": {
    "schema": {"const": "openrig.registry-entry/v1"},
    "slug": {"type": "string"},
    "name": {"type": "string"},
    "summary": {"type": "string"},
    "source": {"type": "object"},
    "configurations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "packageDigest", "behaviour"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "alias": {"type": "string"},
          "recommended": {"type": "boolean"},
          "packageDigest": {
            "type": "object",
            "required": ["algorithm", "value", "coverage"],
            "properties": {
              "algorithm": {"const": "sha256"},
              "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "coverage": {"const": "openrig.package-digest/v1"}
            },
            "additionalProperties": false
          },
          "assembler": {
            "type": "object",
            "required": ["openrigVersion", "commit"],
            "properties": {
              "openrigVersion": {"type": "string"},
              "commit": {"type": "string"}
            },
            "additionalProperties": false
          },
          "behaviour": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "review": {"type": "object"},
    "status": {"type": "string"}
  },
  "additionalProperties": false
}
