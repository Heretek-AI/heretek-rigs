945d743ec36292dc90210bd3dd2bbd36eb98861b9179cd8d114d8c5aabdfc1eb  bundle-common.v1.schema.json
7fcf3f6201615f2b00794d43f1d8ee6c27d4535f614be5c0b15db227a95fe69a  bundle-configurations.v1.schema.json
df2e6be1d69a2b741804ad46edb8557a136afeb098e00a2d3d33237f5198ece5  bundle-status.v1.schema.json
9693a151398750cb65557f8c106dac76646eed799345cc8c0ce2c62ad1a02be6  registry-entry.v1.schema.json
