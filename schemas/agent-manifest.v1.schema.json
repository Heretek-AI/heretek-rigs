{
  "$id": "https://openrig.dev/schemas/agent-manifest/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "openrig.agent-manifest/v1 (heretek-rigs restored baseline)",
  "type": "object",
  "required": ["name", "version"],
  "properties": {
    "name": {"type": "string"},
    "version": {"const": "1.0"},
    "description": {"type": "string"},
    "defaults": {"type": "object"},
    "imports": {"type": "array"},
    "profiles": {
      "type": "object",
      "required": ["default"],
      "properties": {
        "default": {
          "type": "object",
          "required": ["uses", "lifecycle"],
          "properties": {
            "uses": {
              "type": "object",
              "required": ["skills", "guidance", "subagents", "plugins", "runtime_resources"],
              "properties": {
                "skills": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(heretek-shared:[A-Za-z0-9][A-Za-z0-9._-]*|[A-Za-z0-9][A-Za-z0-9._-]*)$"}},
                "guidance": {"type": "array", "maxItems": 0},
                "subagents": {"type": "array", "maxItems": 0},
                "plugins": {"type": "array", "maxItems": 0},
                "runtime_resources": {"type": "array", "maxItems": 0}
              },
              "additionalProperties": false
            },
            "lifecycle": {"type": "object"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "resources": {"type": "object"},
    "startup": {"type": "object"}
  },
  "additionalProperties": false
}
