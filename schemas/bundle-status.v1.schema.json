{
  "$id": "https://openrig.dev/schemas/bundle-status/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "openrig.status-rule/v1 (heretek-rigs restored baseline)",
  "type": "object",
  "required": ["generated", "listings", "harnessChecks", "bodyDigest"],
  "properties": {
    "generated": {"type": "object"},
    "listings": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "type": "object",
          "required": ["state", "configurations"],
          "properties": {
            "state": {"type": "string"},
            "configurations": {
              "type": "object",
              "patternProperties": {
                ".*": {
                  "type": "object",
                  "properties": {
                    "platforms": {
                      "type": "object",
                      "patternProperties": {
                        ".*": {
                          "type": "object",
                          "properties": {
                            "packageDigests": {
                              "type": "array",
                              "minItems": 1,
                              "items": {
                                "type": "object",
                                "required": ["algorithm", "value", "coverage"],
                                "properties": {
                                  "algorithm": {"const": "sha256"},
                                  "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                                  "coverage": {"const": "openrig.package-digest/v1"}
                                },
                                "additionalProperties": false
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "harnessChecks": {"type": "object"},
    "bodyDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
